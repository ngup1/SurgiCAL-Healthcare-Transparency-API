# Copy to api/.env to run the API outside Docker (make run-api)
# against the docker-compose database (make db-up).
# Inside docker compose, these are set in docker-compose.yml instead.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=surgical
DB_USER=surgical
DB_PASSWORD=surgical
DB_SSL_MODE=disable

# Or a single connection string, which takes precedence over DB_* (what Neon/Render give you):
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Plain-text logs are easier to read locally (the image defaults to JSON).
LOG_JSON=false

# Rate limiting, per client and worker process (defaults shown).
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MINUTE=120
# RATE_LIMIT_SEARCH_PER_MINUTE=30
# Behind a proxy: a header with the real client IP that clients can't forge.
# RATE_LIMIT_CLIENT_IP_HEADER=True-Client-IP
# Temporary: GET /debug/headers echoes request headers, to check the one above arrives.
# DEBUG_HEADERS=true
