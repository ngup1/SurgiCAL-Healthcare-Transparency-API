# Copy to etl/.env. The ETL reads it wherever it is run from.

# Where to load. A single connection string takes precedence over DB_*.
# For Neon use the *direct* endpoint (no "-pooler" in the host) of a branch made
# for the load, not the database the API is serving:
# DATABASE_URL=postgresql://user:password@ep-xxxx.us-west-2.aws.neon.tech/neondb?sslmode=require

# Or the local compose database (make db-up):
DB_HOST=localhost
DB_PORT=5433
DB_NAME=surgical
DB_USER=surgical
DB_PASSWORD=surgical
DB_SSL_MODE=disable

# openFDA API key (free: https://open.fda.gov/apis/authentication/). Only the adverse-event
# step calls the API; without a key it is limited to about 900 product types a day.
# OPENFDA_API_KEY=

# Size of the prices table. Defaults: the 150 most-performed procedures, one row per payer.
# MRF_CPT_LIMIT=150        # 0 = every code in cpt_codes
# MRF_PLAN_DETAIL=false    # true = one row per plan instead of per payer
# MRF_MAX_FILE_MB=4096     # skip price files larger than this
# PRICE_FLOOR_RATIO=0.5    # drop prices below this x the Medicare physician payment; 0 = off

# New Medicare utilization year: set both (see data.cms.gov for the dataset ID).
# CMS_UTILIZATION_DATASET_ID=335e5f35-eca6-482d-87b3-f99883e213e3
# CMS_UTILIZATION_YEAR=2024
# CMS_RVU_URL=https://www.cms.gov/files/zip/rvu26a-updated-12-29-2025.zip

# Opt-in Trilliant enrichment (pip install -r etl/requirements-trilliant.txt):
# TRILLIANT_SHARE_FILE=/path/to/config.share
